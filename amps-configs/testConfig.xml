    <Actions>
        <Action>
            <On>
                <Module>amps-action-on-schedule</Module>
                <Options>
                    <Every>1h</Every>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-remove-journal</Module>
                <Options>
                    <Age>30m</Age>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-startup</Module>
            </On>
            <Do>
                <Module>amps-action-do-remove-journal</Module>
                <Options>
                    <Age>30m</Age>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>enableSourceServerChooserTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-enable-transport</Module>
                <Options>
                    <Transport>test-source-server-chooser</Transport>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>disableSourceServerChooserTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-disable-transport</Module>
                <Options>
                    <Transport>test-source-server-chooser</Transport>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>enableSinkServerChooserTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-enable-transport</Module>
                <Options>
                    <Transport>test-sink-server-chooser</Transport>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>disableSinkServerChooserTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-disable-transport</Module>
                <Options>
                    <Transport>test-sink-server-chooser</Transport>
                </Options>
            </Do>
        </Action>
    </Actions>
