<?xml version="1.0" encoding="UTF-8"?>

<AMPSConfig>

    <Name>AMPS-Flink-Tests</Name>

    <Transports>
        <Transport>
            <Name>any-tcp</Name>
            <Type>tcp</Type>
            <InetAddr>9080</InetAddr>
            <Protocol>amps</Protocol>
        </Transport>
        <Transport>
            <Name>any-ws</Name>
            <Type>tcp</Type>
            <InetAddr>9081</InetAddr>
            <Protocol>websocket</Protocol>
        </Transport>
        <Transport>
            <Name>test-source-server-chooser</Name>
            <Type>tcp</Type>
            <InetAddr>9083</InetAddr>
            <Protocol>amps</Protocol>
        </Transport>
        <Transport>
            <Name>test-sink-server-chooser</Name>
            <Type>tcp</Type>
            <InetAddr>9084</InetAddr>
            <Protocol>amps</Protocol>
        </Transport>
        <Transport>
            <Name>any-tcps</Name>
            <Type>tcps</Type>
            <InetAddr>9085</InetAddr>
            <Protocol>amps</Protocol>
            <Certificate>./flink-connector-amps/src/test/resources/ssl/cert.pem</Certificate>
            <PrivateKey>./flink-connector-amps/src/test/resources/ssl/key.pem</PrivateKey>
            <SecureSocketProtocols>TLSv1.2 TLSv1.3</SecureSocketProtocols>
        </Transport>
    </Transports>

    <Admin>
        <InetAddr>9082</InetAddr>
        <SQLTransport>any-ws</SQLTransport>
        <FileName>./amps-files/connector-tests/stats.db</FileName>
        <WWWAuthenticate>Basic realm="AMPS Admin"</WWWAuthenticate>
        <Interval>1s</Interval>
    </Admin>

    <Logging>
        <Target>
            <Protocol>stdout</Protocol>
            <Level>warning</Level>
            <IncludeErrors>00-0015</IncludeErrors>
        </Target>
        
        <Target>
            <Protocol>file</Protocol>
            <Level>info</Level>
            <FileName>./amps-files/connector-tests/logs/connector_tests.log</FileName>
            <RotationThreshold>10MB</RotationThreshold>
        </Target>
    </Logging>

